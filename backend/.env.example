# Database (SQLite by default - lightweight!)
DATABASE_URL=sqlite:///./expense_tracker.db

# JWT Authentication (REQUIRED)
SECRET_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-STRING-IN-PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Configuration
# Use local filesystem by default (set to True for S3)
USE_S3_STORAGE=False
LOCAL_STORAGE_PATH=./uploads/receipts

# AWS S3 (Optional - only if USE_S3_STORAGE=True)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=expense-receipts
S3_ENDPOINT_URL=

# OCR Configuration (Tesseract is FREE and default!)
# Options: "tesseract" (free, recommended), "google" (paid), "none" (disabled)
OCR_ENGINE=tesseract

# Tesseract Configuration (if OCR_ENGINE=tesseract)
# Leave empty for auto-detection, or set path to tesseract executable
# Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe
# Linux/Mac: usually auto-detected at /usr/bin/tesseract
TESSERACT_CMD=

# Google Cloud Vision (Optional - only if OCR_ENGINE=google)
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# OpenAI API (RECOMMENDED - included with ChatGPT Business!)
# Get your API key from: https://platform.openai.com/account/api-keys
# If you have ChatGPT Business/Plus/Pro, you can get API access
# This enables AI-powered expense categorization
OPENAI_API_KEY=

# Webhook for ERP Integration (Optional)
WEBHOOK_ENABLED=False
WEBHOOK_URL=
WEBHOOK_SECRET=

# Admin Portal
SERVE_ADMIN_PORTAL=True
ADMIN_PORTAL_PATH=./admin-dist

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
ENVIRONMENT=development
DEBUG=True
