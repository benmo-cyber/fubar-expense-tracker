{
  "expo": {
    "name": "FUBAR",
    "slug": "fubar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wildwoodingredients.fubar",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow FUBAR to photograph a receipt.",
          "photosPermission": "Allow FUBAR to add a receipt photo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a4390b7a-a656-4130-b3f1-9d1851f30d4a"
      }
    },
    "owner": "benmo-cyber"
  }
}
